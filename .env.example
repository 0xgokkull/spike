# Database (Supabase / Postgres connection string)
# e.g. postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# or direct: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolution_desk

# PayPal Integration
# Mode: "sandbox" (real PayPal sandbox calls) or "fake" (in-memory simulator)
PAYPAL_MODE=fake
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# LLM Integration
# Provider: "groq" (fast inference via Groq), "anthropic", or "mock" (offline test/demo fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# App Configuration
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
