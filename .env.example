# Database (Postgres connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolution_desk

# PayPal Integration
# Mode: "sandbox" (real PayPal sandbox calls) or "fake" (in-memory simulator)
PAYPAL_MODE=fake
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# LLM Integration
# Provider: "anthropic" or "mock" (offline test/demo fallback)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# App Configuration
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
